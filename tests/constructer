driver.find_element(*CHAPTER_FILLINGS).click()
#проверяем переход в раздел "Начинки"(на странице есть название первой начинки "Мясо бессмертных моллюсков Protostomia")
WebDriverWait(driver, 3).until(expected_conditions.visibility_of_element_located((TEXT_FISH_MEAT)))
